{
  "name": "eld-docs",
  "version": "0.1.0",
  "description": "Documentation site for the Eld blockchain",
  "homepage": "https://docs.eld.network",
  "repository": {
    "type": "git",
    "url": "https://github.com/eldnetwork/eld-docs.git"
  },
  "author": "Eld",
  "license": "MIT",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src docusaurus.config.js sidebars.js eslint.config.mjs vitest.config.js",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "links": "lychee --config .lychee.toml README.md CONTRIBUTING.md SECURITY.md docs",
    "test": "vitest run",
    "ci": "npm run format:check && npm run lint && npm run lint:md && npm test && npm audit --omit=dev --audit-level=critical && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/types": "3.9.2",
    "@eslint/js": "9.39.5",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "markdownlint-cli2": "0.18.1",
    "prettier": "3.9.6",
    "vitest": "3.2.4"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
